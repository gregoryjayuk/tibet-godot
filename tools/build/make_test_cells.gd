extends SceneTree
## Test content for spike S6's streaming (plan chapter 11, 4.3; roadmap RT-14): one scene per 128 m cell over a 2 km
## square round S2's town (16 x 16 cells), each holding the detail layers chapter 11 streams (4.2): 40 collision
## proxies, a prop MultiMesh of 200 and a grass MultiMesh of 600, 8 omni lights, 2 smoke emitters, 4 audio emitters,
## 20 smart-object markers and an occluder, about 117 nodes. The materials are shared resources so the warm-up pass
## can compile them once. Written to world/cells/ (gitignored, regenerated by this script in a few seconds).
## Run headless: /Applications/Godot.app/Contents/MacOS/Godot --headless --path . --script tools/build/make_test_cells.gd

const OUT := "res://world/cells"
const CELL := 128.0
const HALF := 8  ## cells from -8 to 7 on each axis
const SLOPE := 0.4452  ## tan 24°: S2's ground rises towards -z


func _ground(z: float) -> float:
	return SLOPE * -z


func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT))
	var stone := StandardMaterial3D.new()
	stone.albedo_color = Color("#8e8a82")
	stone.roughness = 1.0
	var wood := StandardMaterial3D.new()
	wood.albedo_color = Color("#6b4a32")
	var grass := StandardMaterial3D.new()
	grass.albedo_color = Color("#9a9a55")
	grass.cull_mode = BaseMaterial3D.CULL_DISABLED
	var smoke := StandardMaterial3D.new()
	smoke.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	smoke.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	smoke.albedo_color = Color(0.85, 0.85, 0.9, 0.25)
	smoke.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	ResourceSaver.save(stone, OUT + "/mat_stone.tres")
	ResourceSaver.save(wood, OUT + "/mat_wood.tres")
	ResourceSaver.save(grass, OUT + "/mat_grass.tres")
	ResourceSaver.save(smoke, OUT + "/mat_smoke.tres")
	stone = load(OUT + "/mat_stone.tres")
	wood = load(OUT + "/mat_wood.tres")
	grass = load(OUT + "/mat_grass.tres")
	smoke = load(OUT + "/mat_smoke.tres")
	var prop_mesh := BoxMesh.new()
	prop_mesh.size = Vector3(0.6, 0.5, 0.6)
	prop_mesh.material = stone
	var tuft := QuadMesh.new()
	tuft.size = Vector2(0.5, 0.4)
	tuft.center_offset = Vector3(0, 0.2, 0)
	tuft.material = grass
	var puff := QuadMesh.new()
	puff.size = Vector2(1.2, 1.2)
	puff.material = smoke
	var pm := ParticleProcessMaterial.new()
	pm.direction = Vector3(0, 1, 0)
	pm.spread = 12.0
	pm.initial_velocity_min = 0.6
	pm.initial_velocity_max = 1.0
	pm.gravity = Vector3(0.3, 0.1, 0)
	pm.scale_min = 0.6
	pm.scale_max = 1.6
	ResourceSaver.save(pm, OUT + "/smoke_process.tres")
	pm = load(OUT + "/smoke_process.tres")
	var rng := RandomNumberGenerator.new()
	var nodes := 0
	var files := 0
	for iz in range(-HALF, HALF):
		for ix in range(-HALF, HALF):
			rng.seed = hash(Vector2i(ix, iz))
			var root := Node3D.new()
			root.name = "c_%d_%d" % [ix, iz]
			var x0 := ix * CELL
			var z0 := iz * CELL
			var at := func(x: float, z: float, lift := 0.0) -> Vector3: return Vector3(x, _ground(z) + lift, z)
			for k in 40:
				var body := StaticBody3D.new()
				body.name = "col_%d" % k
				var cs := CollisionShape3D.new()
				var box := BoxShape3D.new()
				box.size = Vector3(rng.randf_range(1, 4), 1.5, rng.randf_range(1, 4))
				cs.shape = box
				body.add_child(cs)
				body.position = at.call(x0 + rng.randf() * CELL, z0 + rng.randf() * CELL, 0.75)
				root.add_child(body)
			# A MultiMesh is stored as data (its mesh and a buffer of transforms) and built by autoload/streamer.gd
			# on the main thread: one created by a threaded load cost 12-14 ms to enter the tree (S6, docs/ISSUES.md).
			for spec in [[prop_mesh, 200, "props"], [tuft, 600, "grass"]]:
				var buf := PackedFloat32Array()
				buf.resize(int(spec[1]) * 12)
				for k in int(spec[1]):
					var t := Transform3D(Basis(Vector3.UP, rng.randf() * TAU), at.call(x0 + rng.randf() * CELL, z0 + rng.randf() * CELL))
					var b := t.basis
					var row := [b.x.x, b.y.x, b.z.x, t.origin.x, b.x.y, b.y.y, b.z.y, t.origin.y, b.x.z, b.y.z, b.z.z, t.origin.z]
					for q in 12:
						buf[k * 12 + q] = row[q]
				var holder := Node3D.new()
				holder.name = spec[2]
				holder.set_meta("multimesh_mesh", spec[0])
				holder.set_meta("multimesh_buffer", buf)
				holder.set_meta("multimesh_aabb", AABB(Vector3(x0, _ground(z0 + CELL) - 2.0, z0), Vector3(CELL, SLOPE * CELL + 6.0, CELL)))
				root.add_child(holder)
			for k in 8:
				var l := OmniLight3D.new()
				l.name = "lamp_%d" % k
				l.light_color = Color(1.0, 0.72, 0.4)
				l.light_energy = 0.8
				l.omni_range = 6.0
				l.position = at.call(x0 + rng.randf() * CELL, z0 + rng.randf() * CELL, 2.2)
				root.add_child(l)
			for k in 2:
				var p := GPUParticles3D.new()
				p.name = "smoke_%d" % k
				p.amount = 24
				p.lifetime = 6.0
				p.process_material = pm
				p.draw_pass_1 = puff
				p.visibility_aabb = AABB(Vector3(-4, 0, -4), Vector3(8, 10, 8))
				p.position = at.call(x0 + rng.randf() * CELL, z0 + rng.randf() * CELL, 3.0)
				root.add_child(p)
			for k in 4:
				var a := AudioStreamPlayer3D.new()
				a.name = "sound_%d" % k
				a.position = at.call(x0 + rng.randf() * CELL, z0 + rng.randf() * CELL, 1.0)
				root.add_child(a)
			for k in 20:
				var m := Marker3D.new()
				m.name = "slot_%d" % k
				m.position = at.call(x0 + rng.randf() * CELL, z0 + rng.randf() * CELL)
				root.add_child(m)
			# An occluder is stored as its box's size: an occluder resource created by a threaded load broke the
			# renderer's RIDs (S6, docs/ISSUES.md), so autoload/streamer.gd builds it on the main thread.
			var occ := Node3D.new()
			occ.name = "occluder"
			occ.set_meta("occluder_box", Vector3(8, 6, 1))
			occ.position = at.call(x0 + CELL / 2.0, z0 + CELL / 2.0, 3.0)
			root.add_child(occ)
			for c in root.get_children():
				c.owner = root
				for g in c.get_children():
					g.owner = root
			nodes += 1 + root.get_child_count() + 40
			var ps := PackedScene.new()
			ps.pack(root)
			ResourceSaver.save(ps, "%s/c_%d_%d.scn" % [OUT, ix, iz])
			root.free()
			files += 1
	print("make_test_cells: %d cells, about %d nodes each, in %s" % [files, nodes / files, ProjectSettings.globalize_path(OUT)])
	quit()
