; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tibetan Alley (stylized)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=30

[autoload]

WorldClock="*res://autoload/world_clock.gd"
Calendar="*res://autoload/calendar.gd"
Quality="*res://autoload/quality.gd"
Controls="*res://autoload/controls.gd"
Telemetry="*res://autoload/telemetry.gd"
TownSim="*res://autoload/town_sim.gd"
Streamer="*res://autoload/streamer.gd"
Codex="*res://autoload/codex.gd"
AudioDirector="*res://autoload/audio_director.gd"
Story="*res://autoload/story.gd"
Save="*res://autoload/save.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/dungkardo_import/plugin.cfg")

[importer_defaults]

scene={
"meshes/create_shadow_meshes": true,
"meshes/force_disable_compression": false,
"meshes/generate_lods": true,
"nodes/use_node_type_suffixes": false
}

